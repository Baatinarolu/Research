# PAIRWIRE on Vercel needs NO environment variables to run.
# These are OPTIONAL, only for the /api/cron background monitor + alerts.
# On Vercel: Project -> Settings -> Environment Variables (then redeploy).
# Never commit real secret values to git.

# Random string, 16+ characters. Vercel Cron sends it as: Authorization: Bearer <value>
CRON_SECRET=

# Background watch set (max 8) and alert tuning
CRON_SYMBOLS=EURUSD,GBPUSD,USDJPY,XAUUSD,SPX500,BTCUSD
CRON_WINDOW_MINUTES=120
CRON_MIN_IMPACT=70
CRON_ALWAYS_NOTIFY=false

# Pick ONE notification channel (or none):
# Slack or Discord incoming webhook URL
ALERT_WEBHOOK_URL=
# ...or a Telegram bot you created with @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
